# Examples only. Copy into a Git-ignored .env or deployment secret store; use distinct app passwords.
# The CA and certificate-covered hostname must come from the reviewed DB System.
# SSH tunnels must keep the certificate hostname as the client host (see README).
MYSQL_HOST=REPLACE_WITH_CERTIFICATE_HOSTNAME
MYSQL_PORT=3306
MYSQL_SSL_MODE=VERIFY_IDENTITY
MYSQL_SSL_CA=C:/Users/YOUR_USER/.oci/mysql-ca.pem

# LL actual default catalog is translacat_ll in config/application-prod.yaml.
# Configure the JVM truststore with the reviewed CA separately; never put its password in Git.
DB_JDBC_URL=jdbc:mysql://REPLACE_WITH_CERTIFICATE_HOSTNAME:3306/translacat_ll?sslMode=VERIFY_IDENTITY
DB_EXPECTED_CATALOG=translacat_ll
DB_USERNAME=translacat_ll_app
DB_PASSWORD=REPLACE_LOCALLY_WITH_LL_ONLY_SECRET
# Run each service's migrations separately with a reviewed migration identity first.
# The existing LL production config defaults to migrate; runtime DML-only users must use validate.
DB_MIGRATION_MODE=validate

# ASP.NET Core / MySqlConnector illustration; verify the service's actual configuration key.
# These separate fields are examples, not a claim that an application consumes this exact file.
CHAT_DB_DATABASE=translacat_chat
CHAT_DB_USERNAME=translacat_chat_app
CHAT_DB_PASSWORD=REPLACE_LOCALLY_WITH_CHAT_ONLY_SECRET
# Connection string shape (supply password from your secret store):
# Server=<certificate-host>;Port=3306;Database=translacat_chat;User ID=translacat_chat_app;Password=<secret>;SslMode=VerifyFull;SslCa=<CA-path>
# Bootstrap runtime users have SELECT/INSERT/UPDATE/DELETE only. Use a separately reviewed
# migration identity for Flyway/EF/Exposed schema changes; never share the admin account with apps.
